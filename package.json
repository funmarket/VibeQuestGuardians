{
  "name": "vibequest-guardians-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/client",
    "apps/api",
    "apps/worker",
    "packages/contracts",
    "packages/testing"
  ],
  "scripts": {
    "test": "tsx --test packages/testing/src/api-runtime.test.ts packages/testing/src/architecture.test.ts packages/testing/src/client-foundation.test.ts packages/testing/src/client-host-authority.test.ts packages/testing/src/error-envelope.test.ts packages/testing/src/identity-host.test.ts packages/testing/src/identity-session.test.ts packages/testing/src/runtime-identity.test.ts packages/testing/src/worker-runtime.test.ts",
    "test:database": "tsx --test packages/testing/src/database-foundation.test.ts",
    "migrate:staging": "tsx apps/api/src/database/run-migrations.ts",
    "typecheck": "tsc --noEmit -p packages/testing/tsconfig.json",
    "typecheck:client": "tsc --noEmit -p apps/client/tsconfig.json",
    "build": "npm run typecheck && npm run typecheck:client && npm run build:client && npm run build:api && npm run build:worker",
    "build:client": "npm run build --workspace @vibequest/client",
    "build:api": "npm run build --workspace @vibequest/api",
    "build:worker": "npm run build --workspace @vibequest/worker",
    "test:built": "tsx --test packages/testing/src/built-artifact.test.ts",
    "format:check": "prettier --check package.json eslint.config.js tsconfig.base.json apps/api/package.json apps/api/tsconfig.json apps/api/tsconfig.build.json apps/api/src apps/client/package.json apps/client/tsconfig.json apps/client/vite.config.ts apps/client/index.html apps/client/src apps/worker/package.json apps/worker/tsconfig.json apps/worker/tsconfig.build.json apps/worker/src packages/contracts/package.json packages/contracts/tsconfig.json packages/contracts/src packages/testing/package.json packages/testing/tsconfig.json packages/testing/src",
    "lint:config": "eslint eslint.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^10.14.0",
    "playwright": "^1.56.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
